<?xml version="1.0" encoding="utf-8"?>
<!--
    The every-folder counter's picker preview: widget_unread_preview.xml with the label that cell
    wears. Never drawn on the home screen; see that file for why the figure is a literal.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_unread_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_unread_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="12"
        android:textColor="@color/widget_unread_count"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_unread_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:text="@string/inbox_unread_view"
        android:textColor="@color/widget_unread_label"
        android:textSize="12sp" />
</LinearLayout>
