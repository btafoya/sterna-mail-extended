<?xml version="1.0" encoding="utf-8"?>
<!--
    ONE row of the latest-messages widget, served by RecentMailWidgetService.

    Every text here is set at runtime and NONE is set in this file: what a row may say is
    RecentMailWidgetContent's decision, taken from the notification-content setting and the app
    lock, and a literal left in this layout would be a line the launcher draws before that rule ever
    runs. ⛔ Nothing here reads a database column either — the factory hands over strings that are
    already decided.

    ⛔ THE ROOT CARRIES AN ID because that is what a tap is attached to (setOnClickFillInIntent in
    RecentMailWidgetService): given to a child instead, only that child would open the message and
    the rest of the row would swallow the touch.

    Same closed list of views as the cell itself: LinearLayout, TextView, ImageView. The unread mark
    is an ImageView switched between VISIBLE and INVISIBLE (never GONE) so that the sender's name
    starts at the same x on every row, read or unread.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_recent_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/widget_recent_row_unread"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/widget_latest_unread"
        android:src="@drawable/widget_recent_unread_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_recent_row_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_row_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_recent_row_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_unread_label"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_recent_row_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textColor="@color/widget_unread_label"
        android:textSize="12sp" />
</LinearLayout>
