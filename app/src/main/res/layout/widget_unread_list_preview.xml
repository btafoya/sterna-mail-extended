<?xml version="1.0" encoding="utf-8"?>
<!--
    What the widget picker shows for the unread-messages list (Android 12+, the previewLayout of
    res/xml-v31/appwidget_info_unread_list.xml). A hand-made copy of widget_recent_preview.xml, for
    the reasons given there, but for one difference: every row is bold, this list holding nothing
    but unread mail, and bold being the row's only unread mark.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_unread_background"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="@dimen/widget_recent_monogram"
            android:layout_height="@dimen/widget_recent_monogram"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_recent_monogram_badge" />

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_recent_account_dot"
            android:visibility="invisible" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Marie Dupont"
            android:textColor="@color/widget_row_primary"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="09:12"
            android:textColor="@color/widget_unread_label"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="@dimen/widget_recent_monogram"
            android:layout_height="@dimen/widget_recent_monogram"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_recent_monogram_badge" />

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_recent_account_dot"
            android:visibility="invisible" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tomasz Nowak"
            android:textColor="@color/widget_row_primary"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="08:41"
            android:textColor="@color/widget_unread_label"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="@dimen/widget_recent_monogram"
            android:layout_height="@dimen/widget_recent_monogram"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_recent_monogram_badge" />

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_recent_account_dot"
            android:visibility="invisible" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ada Lindqvist"
            android:textColor="@color/widget_row_primary"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="07:58"
            android:textColor="@color/widget_unread_label"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
