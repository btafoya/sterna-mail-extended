<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher background, not a copy of it: under -PtestApp src/testApp/res overrides
     `ic_launcher_background` with the amber one, so the test app's shortcut is amber too. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_shortcut_compose_foreground" />
</adaptive-icon>
